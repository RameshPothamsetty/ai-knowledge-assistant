# Copy to .env for local Docker use, then adjust the values.
# Never commit the real .env file.

# Application
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=postgres

# Postgres (read by docker-compose and the postgres profile)
POSTGRES_DB=knowledge
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=change-me

# JDBC URL used by the Spring Boot app
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/knowledge
SPRING_DATASOURCE_USERNAME=knowledge
SPRING_DATASOURCE_PASSWORD=change-me
